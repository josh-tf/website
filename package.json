{
  "name": "josh-tf-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "images": "pnpm build && node scripts/build-images.mjs",
    "astro": "astro",
    "lint": "eslint . && astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spell": "cspell \"src/**/*\" \"*.md\"",
    "check": "pnpm lint && pnpm format:check && pnpm spell && pnpm build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "astro": "^6.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@eslint/js": "^10.0.1",
    "astro-eslint-parser": "^1.3.0",
    "cspell": "^9.7.0",
    "eslint": "^10.0.3",
    "eslint-plugin-astro": "^1.6.0",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "wrangler": "^4.118.0"
  }
}
