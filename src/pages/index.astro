---
import Base from '../layouts/Base.astro';
import Mail from '../components/Mail.astro';
import IconLink from '../components/IconLink.astro';
---

<Base title="josh.tf" description="Josh — software developer based in Melbourne.">
  <main class="shell">
    <h1 class="wordmark">josh<span class="wordmark__dot">.</span>tf</h1>

    <div class="contact"><Mail /></div>

    <nav class="links" aria-label="Links">
      <IconLink href="https://github.com/josh-tf" label="github">
        {/* lucide/github */}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
          ></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </IconLink>

      <IconLink href="https://keybase.io/joshtf/pgp_keys.asc" label="pgp">
        {/* lucide/key-round */}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M2 18v3c0 .6.4 1 1 1h4v-3h3v-3h2l1.4-1.4a6.5 6.5 0 1 0-4-4Z"></path>
          <circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle>
        </svg>
      </IconLink>
    </nav>
  </main>
</Base>
